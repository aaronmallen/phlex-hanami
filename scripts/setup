#!/usr/bin/env sh
#MISE description="Setup the development environment"
#MISE alias=["su"]

set -e

mise trust >/dev/null 2>&1
mise install
bundle install

# The integration specs shell out under these, so they need their own installed bundles.
for gemfile in spec/fixtures/gemfiles/*.gemfile; do
  BUNDLE_GEMFILE="$gemfile" bundle install
done
