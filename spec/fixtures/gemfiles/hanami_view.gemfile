# frozen_string_literal: true

source "https://gem.coop"

gemspec path: File.expand_path("../../..", __dir__)

# The point of this Gemfile: exercise the path where Hanami builds the view context itself.
gem "hanami-action", "~> 3.0"
gem "hanami-mailer", "~> 3.0"
gem "hanami-router", "~> 3.0"
gem "hanami-view", "~> 3.0"
gem "i18n", "~> 1.14"
gem "rack", "~> 3.0"
gem "rack-test", "~> 2.0"
gem "rspec", "~> 3"
